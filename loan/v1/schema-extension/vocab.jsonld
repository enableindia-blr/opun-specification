  },
  "@graph": [
    {"@id":"loan:","@type":"rdfs:Ontology","rdfs:label":"OPuN Loan Domain Vocabulary","rdfs:comment":"Vocabulary for loan products, applications (BAP-originated), and status/fulfillment. Aligned with init/on_init echo and confirm/on_confirm APPLICATION_SUBMITTED flow.","schema:version":"1.0.0"},
    {"@id":"loan:LoanProduct","@type":"rdfs:Class","rdfs:label":"Loan Product","rdfs:comment":"A loan product or offering in the catalog","rdfs:subClassOf":"beckn:Item"},
    {"@id":"loan:LoanPurpose","@type":"rdfs:Class","rdfs:label":"Loan Purpose","rdfs:comment":"Purpose or use of the loan","schema:enumeration":["AGRICULTURE","EDUCATION","BUSINESS","HOUSING","PERSONAL","GROUP","SHG","MICROFINANCE","OTHER"]},
    {"@id":"loan:LoanType","@type":"rdfs:Class","rdfs:label":"Loan Type","rdfs:comment":"Type of loan product","schema:enumeration":["TERM_LOAN","OVERDRAFT","REVOLVING","MICRO_LOAN","SHG_LOAN","EDUCATION_LOAN","HOME_LOAN","OTHER"]},
    {"@id":"loan:RepaymentFrequency","@type":"rdfs:Class","rdfs:label":"Repayment Frequency","rdfs:comment":"Frequency of repayment","schema:enumeration":["WEEKLY","BIWEEKLY","MONTHLY","QUARTERLY","BULLET","OTHER"]},
    {"@id":"loan:LoanApplicationStatus","@type":"rdfs:Class","rdfs:label":"Loan Application Status","rdfs:comment":"Status of a loan application","schema:enumeration":["DRAFT","APPLICATION_SUBMITTED","UNDER_REVIEW","ADDITIONAL_INFO_REQUESTED","APPROVED","REJECTED","CANCELLED","PENDING_DISBURSAL","DISBURSED","ACTIVE","CLOSED","WRITTEN_OFF","DELINQUENT","NPA"]},
    {"@id":"loan:LoanAccountStatus","@type":"rdfs:Class","rdfs:label":"Loan Account Status","rdfs:comment":"Status of loan account post-disbursement","schema:enumeration":["PENDING_DISBURSAL","ACTIVE","CLOSED","WRITTEN_OFF","DELINQUENT","NPA"]},
    {"@id":"loan:LoanApplicationAttributes","@type":"rdfs:Class","rdfs:label":"Loan Application Attributes","rdfs:comment":"Order-level attributes for loan application","rdfs:subClassOf":"beckn:Order"},
    {"@id":"loan:LoanFulfillmentAttributes","@type":"rdfs:Class","rdfs:label":"Loan Fulfillment Attributes","rdfs:comment":"Fulfillment attributes for loan application and account status","rdfs:subClassOf":"beckn:Fulfillment"},
    {"@id":"loan:ApplicationForm","@type":"rdfs:Class","rdfs:label":"Application Form","rdfs:comment":"Loan application form (e.g. XForms 2.0)","rdfs:subClassOf":"schema:Thing"},
